# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Signs session cookies, including the admin and kitchen logins. Use a long random value:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database connection string.
# Production (MySQL via PyMySQL):
DATABASE_URL=mysql+pymysql://dbuser:dbpassword@localhost:3306/void_of_lust?charset=utf8mb4
# Leave DATABASE_URL empty (or delete the line) to use the local SQLite file at instance/database.db.
